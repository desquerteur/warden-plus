<?xml version="1.0" encoding="utf-8"?>
<!-- Warden's only HTTP(S) traffic is the in-app updater talking to GitHub over HTTPS (the
     blocking itself is local DNS filtering over UDP). Forbid cleartext traffic entirely as
     defense-in-depth. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
